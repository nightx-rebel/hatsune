BOT_NAME=Hatsune
PREFIX=!
OWNER=your_telegram_username
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
DB_TYPE=sqlite
DB_PATH=./data/hatsune.db
WA_AUTH_DATABASE_URL=sqlite://./data/wa-auth.sqlite
PAIRING_ENABLED=true
PAIRING_TIMEOUT=180000
PAIRING_CODE_LENGTH=6
REQUIRE_OWNER=false
LOG_LEVEL=info
MAX_RETRIES=5
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=40
CACHE_MAX_ITEMS=5000
API_PORT=3000
DEFAULT_SESSION_NAME=default
